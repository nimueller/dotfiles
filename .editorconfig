# Read by shfmt (check.sh) for the shell scripts, and by editors
root = true

[*.{sh,zsh}]
indent_style = space
indent_size = 4
switch_case_indent = true

[.githooks/*]
indent_style = space
indent_size = 4
switch_case_indent = true

# Generated by `p10k configure`
[config/zsh/p10k.zsh]
ignore = true
