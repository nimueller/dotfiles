/* Notification center: the base theme as a panel docked above the waybar
   bell in the bottom-right corner, with two-line notification cards.

   The window itself is a transparent fullscreen surface. On Wayland rofi only
   sees clicks on its own surface, so this is what lets a click anywhere
   outside the panel close it. */

@import "theme"

window {
    fullscreen:       true;
    width:            100%;
    height:           100%;
    padding:          0;
    background-color: transparent;
    border:           0;
    border-radius:    0;
}

/* Everything around the panel is a transparent, empty button that closes
   rofi when clicked (including the strip over the bar, so the bell toggles) */
mainbox {
    orientation: vertical;
    spacing:     0;
    children:    [ "button-close-top", "bottom-row", "button-close-bottom" ];
}

bottom-row {
    orientation: horizontal;
    expand:      false;
    children:    [ "button-close-left", "panel", "button-close-right" ];
}

button-close-top,
button-close-left {
    expand:  true;
    content: "";
    action:  "kb-cancel";
    cursor:  default;
}

button-close-right {
    expand:  false;
    width:   10px;
    content: "";
    action:  "kb-cancel";
}

button-close-bottom {
    expand:  false;
    padding: 21px 0;
    content: "";
    action:  "kb-cancel";
}

/* The visible notification panel */
panel {
    orientation:      vertical;
    expand:           false;
    width:            500px;
    spacing:          12px;
    padding:          16px;
    background-color: @crust;
    border:           2px;
    border-color:     @surface0;
    border-radius:    16px;
    children:         [ "inputbar", "message", "listview" ];
}

textbox {
    font: "CaskaydiaCove Nerd Font 10";
}

listview {
    lines:        5;
    spacing:      6px;
    fixed-height: true;
    expand:       false;
}

element {
    padding:          10px 12px;
    background-color: @base;
}

element-icon {
    size: 36px;
}

element-text {
    vertical-align: 0.5;
}
