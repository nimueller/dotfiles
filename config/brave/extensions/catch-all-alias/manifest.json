{
  "manifest_version": 3,
  "name": "Catch-All Alias",
  "version": "1.0.0",
  "description": "Suggests an address of your own catch-all domain in email fields, a different one for each website.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["common.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
